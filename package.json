{
  "name": "@zvec/zvec-grep",
  "version": "0.1.5",
  "description": "Agent-friendly hybrid grep with indexed context and lexical fallback.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zvec-ai/zvec-grep.git"
  },
  "bugs": {
    "url": "https://github.com/zvec-ai/zvec-grep/issues"
  },
  "homepage": "https://github.com/zvec-ai/zvec-grep#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "zg": "dist/cli/index.js"
  },
  "files": [
    "README.md",
    "README_CN.md",
    "LICENSE",
    "dist",
    "skills/zvec-grep"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/ripgrep": "^1.18.0",
    "@zvec/zvec": "^0.5.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "node-llama-cpp": "3.18.1"
  }
}
